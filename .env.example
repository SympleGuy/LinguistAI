# Security & Debug
SECRET_KEY=your_django_secret_key_here
DEBUG=True

# Database (Default: local SQLite; or postgresql://user:password@host:port/dbname)
DATABASE_URL=sqlite:///db.sqlite3

# Multi-Provider AI Services (Free & Paid Options)
# Option 1: Google Gemini (Free 100% via https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Option 2: AssemblyAI for Speech-to-Text (Free tier via https://www.assemblyai.com/)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Option 3: OpenAI (GPT-4o-mini & Whisper STT)
OPENAI_API_KEY=your_openai_api_key_here

# Option 4: ElevenLabs for Natural AI Voice (Free 10k chars via https://elevenlabs.io/)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Supabase Auth & PostgreSQL
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
