from django.db import models
import uuid
from django.contrib.auth.models import AbstractUser

class UserProfile(models.Model):
    """
    Model representing the Supabase public.users table (user profiles).
    Based on probe results, we know these columns are NOT NULL:
    - id (uuid)
    - username (string)
    - password_hash (string)
    - target_language (string, default: 'English')
    - proficiency_level (string, default: 'Beginner')
    - subscription_plan (string, default: 'Free')
    - created_at (timestamp with timezone, auto-set)
    """
    id = models.UUIDField(primary_key=True, default=uuid.uuid4, editable=False)
    username = models.CharField(max_length=255, unique=True)
    password_hash = models.CharField(max_length=255, blank=True, null=True)  # Stores hashed password from Supabase
    target_language = models.CharField(max_length=50, default='English')
    proficiency_level = models.CharField(max_length=50, default='Beginner')
    subscription_plan = models.CharField(max_length=50, default='Free')
    created_at = models.DateTimeField(auto_now_add=True)

    class Meta:
        db_table = 'users'
        verbose_name = 'User Profile'
        verbose_name_plural = 'User Profiles'

    def __str__(self):
        return self.username

class Scenario(models.Model):
    """
    Model representing the Supabase public.scenarios table.
    """
    id = models.AutoField(primary_key=True)  # Integer auto-increment confirmed
    title = models.CharField(max_length=255)
    description = models.TextField(blank=True, null=True)  # For 'desc' field from frontend
    system_prompt = models.TextField()
    video_url = models.URLField(blank=True, null=True)
    # Additional fields from frontend scenario definitions
    category = models.CharField(max_length=50, blank=True, null=True)
    cefr = models.CharField(max_length=20, blank=True, null=True)
    duration = models.CharField(max_length=20, blank=True, null=True)
    emoji = models.CharField(max_length=10, blank=True, null=True)
    popular = models.BooleanField(default=False)
    language = models.CharField(max_length=10, blank=True, null=True)  # For 'lang' field from frontend
    # Store complex data as JSON fields
    messages = models.JSONField(default=list, blank=True)  # For 'msgs' from frontend
    feedback = models.JSONField(default=list, blank=True)  # For 'fb' from frontend
    vocabulary = models.JSONField(default=list, blank=True)  # For 'vocab' from frontend

    class Meta:
        db_table = 'scenarios'
        verbose_name = 'Scenario'
        verbose_name_plural = 'Scenarios'

    def __str__(self):
        return self.title

class InteractionLog(models.Model):
    """
    Model representing the Supabase public.interaction_logs table.
    Based on probe results, we know these columns are NOT NULL:
    - id (uuid)
    - session_id (uuid)
    - user_audio_url (string)
    Other columns appeared to allow nulls in our probing.
    """
    id = models.UUIDField(primary_key=True, default=uuid.uuid4, editable=False)
    session_id = models.UUIDField()  # Confirmed NOT NULL
    # Based on probing, positions 2-6 (0-indexed) allowed nulls
    field2 = models.UUIDField(blank=True, null=True)   # Possibly user_id?
    field3 = models.TextField(blank=True, null=True)   # Possibly message or command?
    field4 = models.URLField(blank=True, null=True)    # Possibly media URL?
    field5 = models.URLField(blank=True, null=True)    # Possibly another media URL?
    field6 = models.URLField(blank=True, null=True)    # Possibly another media URL?
    user_audio_url = models.URLField()  # Confirmed NOT NULL
    created_at = models.DateTimeField(auto_now_add=True)

    class Meta:
        db_table = 'interaction_logs'
        verbose_name = 'Interaction Log'
        verbose_name_plural = 'Interaction Logs'

    def __str__(self):
        return f"Interaction {self.id} for session {self.session_id}"

class LearningSession(models.Model):
    """
    Model representing the Supabase public.learning_sessions table.
    Based on probe results, we know these columns are NOT NULL:
    - id (uuid)
    - user_id (uuid)
    - scenario_id (uuid)
    - started_at (timestamp with timezone)
    One column at index 3 (0-indexed) allowed null in our probing.
    """
    id = models.UUIDField(primary_key=True, default=uuid.uuid4, editable=False)
    user_id = models.UUIDField()  # Confirmed NOT NULL
    # We have two nulls in the row: one at index2 and one at index4 (0-indexed)
    # Let's assume:
    #   field2: ??? (nullable)
    #   scenario_id: NOT NULL (based on error when trying to insert null)
    #   started_at: NOT NULL (timestamp with timezone)
    #   ended_at: nullable (based on null at index 4)
    #   field4: ??? (nullable)
    scenario_id = models.UUIDField()  # Not null based on error
    started_at = models.DateTimeField(auto_now_add=True)
    ended_at = models.DateTimeField(blank=True, null=True)
    # There might be an additional nullable field we haven't placed correctly
    field2 = models.UUIDField(blank=True, null=True)   # Possibly nullable
    field4 = models.UUIDField(blank=True, null=True)   # Another possibly nullable field
    overall_score = models.FloatField(null=True, blank=True)  # Common field for sessions

    # There might be more fields (like overall_score, etc.)

    class Meta:
        db_table = 'learningsessions'  # Note: table name appears to be 'learningsessions' not 'learning_sessions'
        verbose_name = 'Learning Session'
        verbose_name_plural = 'Learning Sessions'

    def __str__(self):
        return f"Session {self.id} for user {self.user_id}"